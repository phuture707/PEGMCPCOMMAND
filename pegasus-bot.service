[Unit]
Description=Pegasus Galaxy Autonomous Game Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/peg-mcp
ExecStart=/usr/bin/python3 /opt/peg-mcp/peg_bot.py
Restart=always
RestartSec=15
StandardOutput=append:/opt/peg-mcp/bot.log
StandardError=append:/opt/peg-mcp/bot.log

[Install]
WantedBy=multi-user.target
